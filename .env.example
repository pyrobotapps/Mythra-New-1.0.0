# Optional future connection. Use only a public/publishable key, never a service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Demo content is accepted ONLY in development builds. Release builds always use production.
EXPO_PUBLIC_CATALOG_MODE=demo
# Local-only discovery QA: mixed, empty, gl-only, bl-only, error
EXPO_PUBLIC_DISCOVERY_SCENARIO=mixed
